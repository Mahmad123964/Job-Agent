# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Path to the OAuth client secret downloaded from Google Cloud Console (Desktop app type)
GMAIL_CREDENTIALS_FILE=credentials.json
# Where the OAuth token is cached after first login
GMAIL_TOKEN_FILE=token.json

# --- Optional notification channels (see notifications: in config.yaml) ---
# Slack incoming webhook (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=
# WhatsApp via CallMeBot (free): send "I allow callmebot to send me messages" to the
# CallMeBot number on WhatsApp once, it replies with your apikey. Phone in E.164, e.g. +923001234567
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
