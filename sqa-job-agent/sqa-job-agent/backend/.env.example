# Copy this file to backend/.env and fill in real values.
# Nothing here is a real credential — every value below is a placeholder.
# NOTE: keep comments on their own lines. python-dotenv treats "KEY=  # note"
# as the value "# note", which silently breaks "unset means disabled" checks.

# --- [DATABASE_URL] ---
# Recommended: Postgres — e.g. a free Supabase project (Project Settings → Database →
# Connection string → URI; use the session/transaction pooler URI for serverless hosts).
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Local dev / single-user (zero setup) — still fully supported:
# DATABASE_URL=sqlite:///./jobs.db

POLL_INTERVAL_MINUTES=15

# Individual-contributor QA/test roles only. Lead/Principal/Staff/Manager/Head/Director
# and Analyst titles are excluded in filters.py regardless of this list.
DEFAULT_KEYWORDS=qa engineer,sqa,software quality assurance,quality engineer,test engineer,software tester,automation tester,automation engineer,sdet,quality assurance,qa tester,qa automation,sqa engineer,qa automation engineer,qa specialist,junior qa,tester,automation qa

# --- [PREFERRED_NOTIFIER] --- comma-separated: telegram,discord,email,whatsapp
PREFERRED_NOTIFIER=email

# --- [NOTIFY_SCORE_THRESHOLD] --- only push jobs scoring >= this (0-100).
# 0 (default) = notify for every job that passes the keyword filter. Raise it
# (e.g. 50) to cut noise. The dashboard's "Notification score threshold"
# preference overrides it when non-zero.
NOTIFY_SCORE_THRESHOLD=0

# --- Follow-up reminders --- days after "applied" before a job is flagged for follow-up
FOLLOW_UP_DAYS=7

# --- Daily digest email --- off = per-job emails (default) | daily = ONE summary email a day
# instead of per-job emails (Telegram/Discord/WhatsApp unaffected) | both = per-job AND daily.
DIGEST_MODE=off
# HH:MM in the server's local time zone
DIGEST_SEND_TIME=08:00

# --- Telegram [API_KEYS] ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord [API_KEYS] ---
DISCORD_WEBHOOK_URL=

# --- Email (SMTP) [API_KEYS] ---
# Gmail: use an App Password, not your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# One address, or several separated by commas (each gets its own copy):
# EMAIL_TO=you@gmail.com,teammate@example.com
EMAIL_TO=

# --- WhatsApp via Twilio (optional; paid/approved sender required) ---
# Notifier is a no-op unless ALL FOUR are set. Numbers in "whatsapp:+E164" form,
# e.g. TWILIO_WHATSAPP_FROM=whatsapp:+14155238886 (sandbox), WHATSAPP_TO=whatsapp:+923001234567
# [TWILIO_ACCOUNT_SID] [TWILIO_AUTH_TOKEN] [TWILIO_WHATSAPP_FROM] [WHATSAPP_TO]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TO=

# --- Local Hugging Face classifier (free, offline after first download) ---
# [HF_RELEVANCE_MODEL] [HF_ZEROSHOT_MODEL] [HF_DEVICE]
# Zero-shot default is ~1.6 GB; MoritzLaurer/deberta-v3-base-zeroshot-v2.0 is a lighter option.
HF_RELEVANCE_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_ZEROSHOT_MODEL=facebook/bart-large-mnli
HF_DEVICE=cpu
HF_RELEVANCE_THRESHOLD=0.55
HF_MAX_TEXT_CHARS=1500
HF_PRELOAD=true

# --- Fuzzy dedup (rapidfuzz, 0-100 similarity) ---
DEDUP_LOOKBACK_DAYS=30
DEDUP_TITLE_THRESHOLD=90
DEDUP_COMPANY_THRESHOLD=85

# --- Scoring weights (normalised to 0-100 whatever they sum to) ---
SCORE_SQA_RELEVANCE=40
SCORE_REMOTE=20
SCORE_JUNIOR_FRIENDLY=15
SCORE_PAKISTAN_ELIGIBLE=15
SCORE_FRESHNESS=10

# --- Optional: licensed LinkedIn/Indeed/Glassdoor coverage via JSearch (RapidAPI) ---
# See backend/app/adapters/jsearch.py for why this exists instead of direct scrapers.
JSEARCH_ENABLED=false
RAPIDAPI_KEY=
# Search terms and market (ISO-3166 alpha-2) sent to JSearch's /search-v2
JSEARCH_QUERY=QA engineer remote
JSEARCH_COUNTRY=us
# Only ask JSearch for recent postings: all | month | week | 3days | today
JSEARCH_DATE_POSTED=month
# Keep only these JSearch publishers (the `job_publisher` field; case-insensitive). Everything
# else — Vacancy Global Pro, Lensa, BeBee, Jooble, WhatJobs and other reposting/spam sites — is dropped.
# Empty = keep all.
JSEARCH_TRUSTED_PUBLISHERS=LinkedIn,Indeed,Glassdoor,ZipRecruiter,Monster,CareerBuilder,Dice,Jobgether

# --- Hard freshness filter (days). Older postings are neither saved nor notified.
MAX_JOB_AGE_DAYS=14
# Longer window for single-employer ATS boards (Greenhouse/Ashby/Lever) — they list a
# job until it's filled, not daily like aggregator feeds.
MAX_JOB_AGE_DAYS_ATS_BOARDS=30
# Undated postings are excluded too (can't be proven fresh). Set true to let them through.
ALLOW_UNDATED_JOBS=false

# --- Notification ledger: file outside the DB recording what was already notified,
# so deleting/recreating jobs.db never re-sends the same postings.
NOTIFY_LEDGER_PATH=./notified_ledger.jsonl
NOTIFY_LEDGER_DAYS=45

# --- Deep region check: a job left "Unclear" by the feed/API description gets its own
# posting page fetched once and re-classified against the fuller text before being
# excluded at the notification gate. Cached outside the DB, like the notification ledger.
DEEP_REGION_CHECK_ENABLED=true
DEEP_REGION_FETCH_TIMEOUT_SECONDS=15
DEEP_REGION_CACHE_PATH=./deep_region_cache.jsonl
# Sources never fetched for a deep check (comma-separated). JSearch aggregates
# LinkedIn/Indeed/Glassdoor, which this project never scrapes directly.
DEEP_REGION_EXCLUDED_SOURCES=jsearch

# --- Secondary recall: generic engineering titles ("Software Engineer") whose description
# embeds as clearly QA-focused (calibrated relevance >= threshold) are admitted too. 0 = off.
DESCRIPTION_RECALL_THRESHOLD=0.70
DESCRIPTION_RECALL_MIN_CHARS=200

# --- Seconds a single source may take per poll before it is skipped for that cycle
ADAPTER_TIMEOUT_SECONDS=60

# --- Admin API key --- sent as X-Api-Key on every non-GET request (dashboard reads VITE_ADMIN_API_KEY).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Frontend origins (for CORS) --- comma-separated; localhost/127.0.0.1 on any port is
# always allowed as well, so a Vite fallback port (5174, 5175, ...) keeps working.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
FRONTEND_ORIGIN=http://localhost:5173
